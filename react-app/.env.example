# Copy to react-app/.env for local development.
# Vite embeds these at build time for production (set them in Render static site settings).

VITE_API_URL=http://localhost:5000
# Optional in production: direct API host for long classify requests (bypasses static proxy)
# VITE_API_DIRECT_URL=https://fabai-api-n4ki.onrender.com
VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
